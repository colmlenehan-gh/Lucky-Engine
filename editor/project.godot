; Lucky editor application. Project paths resolve at runtime.
config_version=5

[application]
config/name="Lucky"
config/version="0.1.0-beta"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
config/use_custom_user_dir=true
config/custom_user_dir_name="Lucky"

[display]
window/size/viewport_width=1600
window/size/viewport_height=1000
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/size/min_width=1100
window/size/min_height=700

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
textures/default_filters/use_nearest_mipmap_filter=false

[audio]
driver/enable_input=false
